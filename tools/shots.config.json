{
  "name": "pcds",
  "defaultUrl": "https://preview.pcds2030.com",
  "outDir": "shots",
  "defaults": {
    "devices": ["phone"],
    "themes": ["light", "dark"],
    "crop": ".project-card",
    "pad": 24
  },
  "crop": { "minAspect": 0.75, "maxAspect": 1.3 },
  "theme": {
    "supported": ["light", "dark"],
    "localStorageKey": "pcds-theme",
    "attribute": "data-theme",
    "attributeValues": { "light": "light", "dark": "dark" },
    "setColorScheme": true,
    "themeColor": { "light": "#ffffff", "dark": "#121212" }
  },
  "localStorage": {},
  "sessionStorage": { "pcds-v2-intro-seen": "1" },
  "readySelector": "#root",
  "settleMs": 250
}
